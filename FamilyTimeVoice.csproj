<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>FamilyTimeVoice</AssemblyName>
    <Version>0.2.2</Version>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <GameDir Condition="'$(GameDir)' == '' and '$(FAMILY_TIME_GAME_DIR)' != ''">$(FAMILY_TIME_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$(USERPROFILE)\Games\Family Time</GameDir>
    <LoaderDir Condition="'$(LoaderDir)' == ''">$(MSBuildProjectDirectory)\.tools\bepinex</LoaderDir>
  </PropertyGroup>
  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDir)\FamilyTime_Data\Managed\Assembly-CSharp.dll')" Text="Supply your own game location with -p:GameDir=PATH, or run scripts/build.ps1 -GameDir PATH for automatic game validation." />
  </Target>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Reference Include="$(GameDir)\FamilyTime_Data\Managed\*.dll" Exclude="$(GameDir)\FamilyTime_Data\Managed\Newtonsoft.Json.dll;$(GameDir)\FamilyTime_Data\Managed\UnityEngine.AudioModule.dll;$(GameDir)\FamilyTime_Data\Managed\UnityEngine.IMGUIModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(MSBuildProjectDirectory)\.tools\unity-full-runtime-6000.2.12\UnityEngine.AudioModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(MSBuildProjectDirectory)\.tools\unity-full-runtime-6000.2.12\UnityEngine.IMGUIModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(MSBuildProjectDirectory)\.tools\json\FamilyTimeVoice.Json.dll"><Private>true</Private></Reference>
    <Reference Include="$(LoaderDir)\BepInEx\core\BepInEx.dll"><Private>false</Private></Reference>
    <Reference Include="$(LoaderDir)\BepInEx\core\0Harmony.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
